---
import { nav as allNav, site } from '../data/site';
import { hasPublishedPosts } from '../lib/posts';

const showWriting = await hasPublishedPosts();
const nav = allNav.filter((item) => showWriting || item.href !== '/blog/');

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Furniture: the app bar may run full-bleed. -->
<header class="sticky top-0 z-(--ds-z-sticky) border-b border-hairline bg-surface-rest/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-4xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="type-label rounded-lg text-ink">{site.shortName}</a>

    <!-- Current page: full-strength text plus a 2 px accent bar on the header's bottom edge.
         The bar is a border, so it survives forced colours. -->
    <nav class="hidden self-stretch md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'type-footnote relative flex items-center rounded-lg px-3 after:absolute after:inset-x-3 after:-bottom-px after:border-b-2',
              isActive(item.href)
                ? 'font-semibold text-ink after:border-accent-fill'
                : 'text-ink-secondary after:border-transparent hover:text-ink',
            ]}
          >
            <span class="grid">
              <span class="col-start-1 row-start-1">{item.label}</span>
              {/* Invisible bold copy reserves width so the active weight never shifts the row. */}
              <span class="invisible col-start-1 row-start-1 font-semibold" aria-hidden="true">
                {item.label}
              </span>
            </span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch between light and dark theme"
        class="state-composite rounded-lg border border-transparent p-2.5 text-ink-secondary"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="state-composite rounded-lg border border-transparent p-2.5 text-ink-secondary md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-hairline px-4 py-2 md:hidden" aria-label="Mobile">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'type-control state-composite flex min-h-11 items-center rounded-r-lg border-l-2 px-3',
            isActive(item.href)
              ? 'border-accent-fill bg-accent-tint font-semibold text-accent-text'
              : 'border-transparent text-ink',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>
