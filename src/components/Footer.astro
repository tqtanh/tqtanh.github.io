---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<!-- Furniture: hairline above, no fill of its own. -->
<footer class="border-t border-hairline">
  <div
    class="mx-auto flex max-w-4xl flex-col items-start justify-between gap-2 px-4 py-6 sm:flex-row sm:items-center sm:px-6"
  >
    <p class="type-footnote text-ink-secondary">
      © <span class="tabular-nums">{new Date().getFullYear()}</span>{' '}{site.name} · {site.location}
    </p>
    <SocialLinks />
  </div>
</footer>
