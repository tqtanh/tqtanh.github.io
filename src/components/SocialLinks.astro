---
import { links } from '../data/site';

const items = [
  {
    label: 'Email',
    href: `mailto:${links.email}`,
    path: 'M3 6.75A1.75 1.75 0 0 1 4.75 5h14.5A1.75 1.75 0 0 1 21 6.75v10.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25V6.75Zm1.6.05L12 12.4l7.4-5.6',
    stroke: true,
  },
  {
    label: 'LinkedIn',
    href: links.linkedin,
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4V9.75Z',
  },
  {
    label: 'ResearchGate',
    href: links.researchgate,
    text: 'RG',
  },
  {
    label: 'GitHub',
    href: links.github,
    path: 'M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.9c.85 0 1.7.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.1 10.1 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z',
  },
].filter((i) => i.href);
---

<ul class="flex items-center gap-1">
  {
    items.map((i) => (
      <li>
        <a
          href={i.href}
          aria-label={i.label}
          target={i.href.startsWith('mailto:') ? undefined : '_blank'}
          rel="noopener noreferrer"
          class="state-composite inline-flex rounded-lg border border-transparent p-2.5 text-ink-secondary"
        >
          <svg
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill={i.stroke ? 'none' : 'currentColor'}
            stroke={i.stroke ? 'currentColor' : undefined}
            stroke-width={i.stroke ? 1.8 : undefined}
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {i.text ? (
              <>
                <rect x="2.5" y="2.5" width="19" height="19" rx="3" />
                <text
                  x="12"
                  y="16"
                  text-anchor="middle"
                  font-size="9.5"
                  font-weight="700"
                  font-family="var(--font-sans)"
                  fill="var(--ds-surface-rest)"
                >
                  {i.text}
                </text>
              </>
            ) : (
              <path d={i.path} />
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>
